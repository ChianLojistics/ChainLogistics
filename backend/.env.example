# ChainLogistics Backend Configuration
# Environment profile (development|production|test)
CHAINLOGISTICS_ENV=development

# Database
DATABASE_URL=postgres://chainlogistics:password@localhost/chainlogistics

# Server
HOST=0.0.0.0
PORT=3001

# TLS/SSL Configuration
TLS_ENABLED=false
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem

# Security
ENFORCE_HTTPS=true
HSTS_MAX_AGE=31536000
ALLOWED_ORIGINS=https://localhost:3000,https://app.chainlogistics.com,https://*.chainlogistics.com

# Redis
REDIS_URL=redis://localhost:6379

# Required secrets
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
JWT_SECRET=replace_with_minimum_16_character_secret

# Logging
RUST_LOG=info
LOG_FORMAT=json

# Decentralized storage (IPFS / Arweave)
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=http://127.0.0.1:5001
ARWEAVE_GATEWAY=https://arweave.net/
ARWEAVE_UPLOAD_URL=https://node2.arweave.net/tx
STORAGE_VERIFICATION_INTERVAL_SECS=900
STORAGE_VERIFICATION_BATCH_SIZE=50

# Optional nested overrides (config as code)
# CHAINLOGISTICS__SERVER__PORT=3001
# CHAINLOGISTICS__SECURITY__ENFORCE_HTTPS=true
