# ChainLogistics Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# STELLAR BLOCKCHAIN CONFIGURATION
# =============================================================================

# Stellar Soroban Contract ID (REQUIRED)
# Get this from deploying your smart contract
NEXT_PUBLIC_CONTRACT_ID=CBUWSKT2UGOAXK4ZREVDJV5XHSYB42PZ3CERU2ZFUTUMAZLJEHNZIECA

# Stellar Network (testnet|mainnet|futurenet)
# Default: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stellar RPC URL (optional - will use default based on network)
# Custom Soroban RPC endpoint
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# MULTI-BLOCKCHAIN SUPPORT
# =============================================================================

# Ethereum Configuration
NEXT_PUBLIC_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_ETH_CONTRACT_ID=

# Polygon Configuration
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_POLYGON_CONTRACT_ID=

# Hyperledger Fabric Configuration
NEXT_PUBLIC_HYPERLEDGER_RPC_URL=
NEXT_PUBLIC_HYPERLEDGER_CONTRACT_ID=

# Corda Configuration
NEXT_PUBLIC_CORDA_RPC_URL=
NEXT_PUBLIC_CORDA_CONTRACT_ID=

# Quorum Configuration
NEXT_PUBLIC_QUORUM_RPC_URL=
NEXT_PUBLIC_QUORUM_CONTRACT_ID=

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Backend API URL
# Default: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for real-time updates
# Default: ws://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Monitoring endpoint for performance tracking and error reporting
# Optional - if not set, monitoring data will be logged to console in development
NEXT_PUBLIC_MONITORING_ENDPOINT=

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=

# Sentry DSN for error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_REALTIME_UPDATES=true
NEXT_PUBLIC_ENABLE_QR_CODES=true
NEXT_PUBLIC_ENABLE_BATCH_OPERATIONS=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development mode settings
# These are typically only used in development
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=info

# Mock data settings
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_MOCK_DELAY_MS=500

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# Authentication settings
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_AUTH_PROVIDER=freighter

# CORS settings (if needed for development)
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================

# Cache settings
NEXT_PUBLIC_CACHE_DURATION=300000
NEXT_PUBLIC_ENABLE_OFFLINE_SUPPORT=true

# Performance budgets
NEXT_PUBLIC_PERFORMANCE_BUDGET_WARNING=1200
NEXT_PUBLIC_PERFORMANCE_BUDGET_CRITICAL=2500

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================

# Theme and appearance
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Localization
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,es,fr,de,ja,zh

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test environment settings
# These are typically only used in test environments
NEXT_PUBLIC_TEST_MODE=false
NEXT_PUBLIC_TEST_WALLET_ADDRESS=
NEXT_PUBLIC_TEST_CONTRACT_ID=

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# IPFS settings (for decentralized storage)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_PINATA_API_KEY=
NEXT_PUBLIC_PINATA_SECRET_KEY=

# QR code generation service
NEXT_PUBLIC_QR_CODE_API_URL=https://api.qrserver.com/v1/create-qr-code/

# =============================================================================
# EXAMPLE VALUES FOR DEVELOPMENT
# =============================================================================

# Example Stellar Testnet Configuration:
# NEXT_PUBLIC_CONTRACT_ID=CBUWSKT2UGOAXK4ZREVDJV5XHSYB42PZ3CERU2ZFUTUMAZLJEHNZIECA
# NEXT_PUBLIC_STELLAR_NETWORK=testnet
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Example Local Development:
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
# NEXT_PUBLIC_USE_MOCK_DATA=true

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your actual values in .env.local
#
# 3. For production deployment, set these in your hosting platform's
#    environment variables (Vercel, Netlify, etc.)
#
# 4. Never commit .env.local to version control
#
# 5. Variables starting with NEXT_PUBLIC_ are exposed to the browser
#    - Do not put secret keys or sensitive data in them
#   - Use server-side environment variables for secrets

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Common issues:
# - "Contract ID not configured": Set NEXT_PUBLIC_CONTRACT_ID
# - "Network connection failed": Check RPC URLs and network settings
# - "CORS errors": Verify CORS origins and API URLs
# - "Real-time updates not working": Check WebSocket URL configuration

# For more help, see:
# - Contributing.md: /Contributing.md
# - Architecture documentation: /frontend/ARCHITECTURE.md